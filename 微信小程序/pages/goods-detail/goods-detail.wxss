/* pages/goods-detail/goods-detail.wxss — 商品详情页 */

.detail-page {
  /* 底部留出固定操作栏的空间 */
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* ===== 缓存提示 ===== */
.cache-tip {
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
  background: rgba(230, 162, 60, 0.12);
  border: 1rpx solid rgba(230, 162, 60, 0.3);
  border-radius: 14rpx;
  font-size: 24rpx;
  color: var(--warning);
}

/* ===== 演示数据提示 ===== */
.demo-tip {
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
  background: rgba(91, 158, 255, 0.12);
  border: 1rpx solid rgba(91, 158, 255, 0.3);
  border-radius: 14rpx;
  font-size: 24rpx;
  color: var(--brand);
}

/* ===== 主图 ===== */
.hero-img-wrap {
  width: 100%;
  height: 560rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: var(--bg-elevated);
  margin-bottom: 24rpx;
}

.hero-img {
  width: 100%;
  height: 100%;
}

.hero-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.hero-ph-icon { font-size: 100rpx; opacity: 0.4; }
.hero-ph-text { font-size: 26rpx; color: var(--text-muted); }

/* ===== 价格卡 ===== */
.main-card {
  margin-bottom: 24rpx;
}

.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.detail-price {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--danger);
}

.detail-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.detail-desc {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}

/* ===== 商家卡 ===== */
.merchant-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.merchant-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--bg-hover);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-img { width: 100%; height: 100%; }
.avatar-ph { font-size: 36rpx; }

.merchant-detail {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.merchant-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.merchant-addr {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.merchant-arrow {
  font-size: 24rpx;
  color: var(--brand-deep);
  flex-shrink: 0;
}

/* ===== 信息明细 ===== */
.card-hd {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-regular);
  margin-bottom: 20rpx;
}

.kv-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-base);
}

.kv-row:last-child { border-bottom: none; }

.kv-label {
  font-size: 26rpx;
  color: var(--text-muted);
  flex-shrink: 0;
}

.kv-value {
  font-size: 26rpx;
  color: var(--text-primary);
  text-align: right;
  word-break: break-all;
}

/* ===== 购物车数量 ===== */
.qty-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

/* 详情页在这里使用紧凑控件，按钮 40rpx（介于卡片 34 与全局 44 之间） */
.qty-row .qty-btn {
  width: 40rpx;
  height: 40rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
}

.qty-row .qty-num {
  min-width: 56rpx;
  font-size: 26rpx;
}

.qty-hint {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* ===== 底部操作栏 ===== */
.detail-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg-card-solid);
  border-top: 1rpx solid var(--border-base);
}

.bar-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex-shrink: 0;
}

.bar-price {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--danger);
}

.bar-stock {
  font-size: 22rpx;
  color: var(--text-muted);
}

.bar-buy {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}
