/* pages/user/trade/trade.wxss
 * 颜色统一使用 app.wxss 的主题变量，自动适配深色 / 浅色模式。
 */

/* ===== 搜索输入行 ===== */
.search-bar {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.search-bar .search-input {
  flex: 1;
  min-width: 0;
}

/* ===== 操作行：搜索 / 重置 / 高级搜索 等宽并排铺满整行 =====
 * 注意：小程序原生 button 默认块级，必须显式 display:flex + flex:1
 * 才能让它们在同一行且等分宽度。
 */
.toolbar {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.toolbar .btn {
  display: flex;
  flex: 1 1 0;
  width: 100%;
  min-width: 0;
  height: 72rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.price-range {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
}

.range-sep { color: var(--text-muted); font-size: 26rpx; }

/* picker 展示块：必须显式给底色与边框（否则露出原生白底） */
.picker-value {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 76rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  background: var(--bg-input);
  border: 1rpx solid var(--border-input);
  border-radius: 12rpx;
  color: var(--text-primary);
  font-size: 28rpx;
}

/* ===== 订单卡片 ===== */
.trade-card {
  background: var(--bg-card);
  border: 1rpx solid var(--border-base);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.05);
}

.trade-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-bottom: 18rpx;
  margin-bottom: 14rpx;
  border-bottom: 1rpx solid var(--border-base);
}

.trade-order {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-muted);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.trade-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 8rpx 0;
}

.trade-label {
  width: 160rpx;
  font-size: 24rpx;
  color: var(--text-muted);
  flex-shrink: 0;
}

.trade-value {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
  min-width: 0;
}

.trade-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--border-base);
}
