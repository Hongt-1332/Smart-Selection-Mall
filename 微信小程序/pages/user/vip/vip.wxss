/* pages/user/vip/vip.wxss */
.vip-banner {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 40rpx;
  padding: 56rpx 32rpx;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 35%, #2d1b2e 100%);
}

.vip-banner-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  text-align: center;
}

.crown-icon { font-size: 88rpx; }

.banner-h1 {
  font-size: 42rpx;
  font-weight: 700;
  color: #e6a23c;
  letter-spacing: 2rpx;
}

.banner-p { font-size: 26rpx; color: #a0a4b8; }

/* ===== 套餐 ===== */
.vip-plans {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.plan-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 52rpx 36rpx 36rpx;
  border-radius: 22rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border-base);
}

.plan-featured {
  border: 3rpx solid rgba(230, 162, 60, 0.5);
  background: linear-gradient(180deg, rgba(230, 162, 60, 0.1), transparent);
}

.plan-badge {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translate(-50%, -50%);
  padding: 8rpx 30rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #e6a23c, #f56c6c);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}

.plan-icon { font-size: 64rpx; }
.plan-name { font-size: 34rpx; color: var(--text-primary); font-weight: 600; }

.plan-price { display: flex; align-items: baseline; gap: 4rpx; }
/* 货币符号：用中性灰蓝，融进深色卡片底；
 * 原先的橙黄（--warning）与深蓝背景冲突，显得刺眼 */
.currency { font-size: 32rpx; color: var(--text-secondary); font-weight: 600; }
.amount { font-size: 72rpx; color: var(--warning); font-weight: 700; line-height: 1; }
.period { font-size: 26rpx; color: var(--text-secondary); }

.plan-benefit {
  display: flex;
  align-items: center;
  gap: 14rpx;
  width: 100%;
  padding: 10rpx 0;
}

.benefit-check { color: var(--success); font-size: 28rpx; font-weight: 700; flex-shrink: 0; }
.plan-benefit-text { font-size: 26rpx; color: var(--text-regular); flex: 1; }

/* 套餐按钮：强制占满卡片整行。
 * 小程序原生 button 默认样式（宽度 / auto 外边距）会让它缩成内容宽、
 * 靠一边放置，这里显式铺满并居中内容。 */
.plan-btn {
  margin-top: 20rpx;
  height: 84rpx;
  border-radius: 14rpx;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin-left: 0;
  margin-right: 0;
  box-sizing: border-box;
}

/* 当前等级角标：右上角，绿色系，与 info 页「已开通」角标同一风格 */
.plan-owned-badge {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  line-height: 1.5;
  background: rgba(103, 194, 58, 0.15);
  border: 1rpx solid rgba(103, 194, 58, 0.35);
  color: #67c23a;
}

/* 已包含角标：低等级被当前等级覆盖，灰色弱化 */
.plan-included-badge {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  line-height: 1.5;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  color: #8890a0;
}

/* 当前等级卡片：绿色细边，弱化购买引导 */
.plan-owned {
  border-color: rgba(103, 194, 58, 0.35);
}

/* ===== 支付（弹层内） ===== */
.pay-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 32rpx 0;
  /* 使用弹层内的浅色底，与弹层实色背景协调 */
  background: var(--sheet-soft, rgba(255, 255, 255, 0.05));
  border: 1rpx solid var(--border-base);
  border-radius: 18rpx;
}

.pay-plan-name { font-size: 34rpx; color: var(--text-primary); font-weight: 600; }
.pay-price { font-size: 80rpx; color: var(--warning); font-weight: 700; line-height: 1.1; }
.pay-duration { font-size: 26rpx; color: var(--text-secondary); }
