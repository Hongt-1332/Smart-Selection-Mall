/* pages/user/info/info.wxss */
/* ===== 未登录 ===== */
.not-logged-in {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 160rpx 40rpx;
}

.nl-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  padding: 80rpx 40rpx;
  border-radius: 28rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border-input);
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.12);
}

.nl-icon { font-size: 100rpx; }
.nl-text { font-size: 40rpx; font-weight: 700; color: var(--text-primary); }
.nl-sub { font-size: 26rpx; color: var(--text-muted); }

.nl-btn {
  margin-top: 20rpx;
  padding: 0 80rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #5b8def, #7c5ce7);
  color: #fff;
  font-size: 30rpx;
}

/* ===== 顶部信息 ===== */
.profile-banner {
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  /* 品牌渐变：深浅模式下都协调 */
  background: linear-gradient(145deg, rgba(99, 102, 241, 0.16), rgba(139, 92, 246, 0.07));
  border: 1rpx solid rgba(99, 102, 241, 0.22);
}

.banner-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
  padding: 48rpx 32rpx;
}

.avatar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-ring {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  border: 4rpx solid var(--border-strong);
  background: var(--bg-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: 0 0 0 10rpx rgba(99, 102, 241, 0.1), 0 8rpx 32rpx rgba(0, 0, 0, 0.18);
}

.avatar-img { width: 100%; height: 100%; }
.avatar-icon { font-size: 72rpx; }

.avatar-edit {
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #5b9eff, #5b8def);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  border: 4rpx solid #151b35;
}

.upload-hint { font-size: 24rpx; color: var(--text-muted); margin-top: 12rpx; }

.info-grid {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.info-cell {
  width: calc((100% - 18rpx) / 2);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border-base);
}

/* 余额格不做任何特殊背景/边框，与其它信息格保持一致；
 * 仅保留金额数字的品牌蓝作为唯一强调 */

.cell-label {
  font-size: 22rpx;
  color: var(--text-muted);
  letter-spacing: 2rpx;
}

.cell-val {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cell-val-balance {
  font-size: 42rpx;
  font-weight: 800;
  color: #5b9eff;
}

/* ===== 卡片 ===== */
.section-card {
  background: var(--bg-card);
  border: 1rpx solid var(--border-input);
  border-radius: 22rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.05);
}

.card-hd {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-regular);
  margin-bottom: 24rpx;
}

.card-hd-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.card-hd-row .card-hd { margin-bottom: 0; }

/* ===== 表单提交按钮：独占一行、通栏、内容居中 =====
 * 原生 button 默认样式会让它缩成内容宽、靠边放置，
 * 这里显式铺满并压住 auto 外边距。 */
.form-btn {
  display: flex;
  width: 100%;
  height: 84rpx;
  align-items: center;
  justify-content: center;
  margin: 28rpx 0 8rpx;
  border-radius: 14rpx;
  box-sizing: border-box;
}

.form-btn::after { border: none; }

/* ===== 背景槽位 ===== */
.bg-slots {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.bg-slot {
  width: calc((100% - 16rpx) / 2);
  border-radius: 16rpx;
  border: 1rpx solid var(--border-base);
  background: var(--bg-soft);
  padding: 12rpx;
}

.slot-label { font-size: 20rpx; color: var(--text-muted); }

/* 槽位头部：标签居左，右侧「点击更换」文字入口（替代原上传按钮） */
.slot-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.slot-action {
  font-size: 20rpx;
  color: #5b9eff;
}

.slot-img-wrap {
  position: relative; /* 上传中遮罩的定位参照 */
  width: 100%;
  height: 170rpx;
  margin: 8rpx 0;
  border-radius: 12rpx;
  overflow: hidden;
}

.slot-img { width: 100%; height: 100%; }

/* 上传中：盖在图片上的半透明遮罩 */
.slot-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.55);
  color: #ffffff;
  font-size: 22rpx;
}

/* 空槽：品牌蓝虚线框 + 引导文案，整块可点 */
.slot-empty {
  width: 100%;
  height: 170rpx;
  margin: 8rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border: 2rpx dashed rgba(91, 158, 255, 0.35);
  border-radius: 12rpx;
}

.slot-placeholder { font-size: 44rpx; opacity: 0.35; }
.slot-empty-text { font-size: 20rpx; color: var(--text-muted); }

/* ===== 额度 ===== */
.quota-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.quota-block {
  width: calc((100% - 16rpx) / 2);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 22rpx 16rpx;
  border-radius: 16rpx;
  background: var(--bg-soft);
  border: 1rpx solid var(--border-base);
}

.q-icon { font-size: 36rpx; }
.q-name { font-size: 22rpx; color: var(--text-muted); }

.q-bar {
  width: 100%;
  height: 14rpx;
  border-radius: 8rpx;
  background: var(--bg-hover);
  overflow: hidden;
}

.q-bar-inner {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.4s;
}

.q-num { display: flex; align-items: baseline; gap: 4rpx; }
.q-used { font-size: 30rpx; font-weight: 700; color: var(--text-primary); }
.q-sep { font-size: 22rpx; color: var(--text-muted); }
.q-max { font-size: 24rpx; color: var(--text-muted); }
.q-unit { font-size: 20rpx; color: var(--text-muted); }

/* ===== VIP ===== */
.vip-card {
  background: linear-gradient(165deg, rgba(212, 175, 55, 0.1), transparent);
  border-color: rgba(212, 175, 55, 0.28) !important;
}

.vip-hd { color: #d4af37; }

.vip-link { font-size: 24rpx; color: #d4af37; }

.vip-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.vip-crown { font-size: 72rpx; }
.vip-tier-name { font-size: 32rpx; font-weight: 700; color: var(--text-primary); }
.vip-tier-desc { font-size: 22rpx; color: var(--text-muted); }

.vip-benefits {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(212, 175, 55, 0.07);
  border: 1rpx solid rgba(212, 175, 55, 0.15);
  margin-top: 12rpx;
}

.benefit-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 24rpx;
  color: var(--text-regular);
}

.benefit-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #d4af37, #f0d77a);
  flex-shrink: 0;
}

.benefit-empty { font-size: 24rpx; color: var(--text-muted); text-align: center; padding: 16rpx 0; }

.upgrade-btn {
  width: 100%;
  height: 88rpx;
  margin-top: 20rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #d4af37, #b8962e);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

/* 满级提示：替代升级按钮的位置，绿色系传达「已达成」 */
.vip-maxed-tip {
  width: 100%;
  height: 88rpx;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: 16rpx;
  background: rgba(103, 194, 58, 0.1);
  border: 1rpx solid rgba(103, 194, 58, 0.35);
  color: #67c23a;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-sizing: border-box;
}

/* ===== VIP 方案 ===== */
.vip-dialog-empty {
  text-align: center;
  padding: 80rpx 0;
  color: var(--text-muted);
  font-size: 28rpx;
}

.vip-plan-card {
  position: relative; /* 「已开通」角标的定位参照 */
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 36rpx 28rpx;
  border-radius: 22rpx;
  /* 弹层内使用专用浅色底，保证在实色弹层背景上可见 */
  background: var(--sheet-soft, rgba(255, 255, 255, 0.05));
  border: 2rpx solid var(--border-base);
  margin-bottom: 20rpx;
}

.vip-plan-featured {
  border-color: rgba(212, 175, 55, 0.5);
  background: linear-gradient(165deg, rgba(212, 175, 55, 0.12), rgba(212, 175, 55, 0.03));
}

.plan-icon { font-size: 56rpx; }
.plan-name { font-size: 30rpx; font-weight: 600; color: var(--text-primary); }

/* 已开通角标：卡片右上角，与「最受欢迎」角标同一风格体系 */
.plan-owned-badge {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  line-height: 1.5;
  background: rgba(103, 194, 58, 0.15);
  border: 1rpx solid rgba(103, 194, 58, 0.35);
  color: #67c23a;
}

/* 已包含角标：低等级被当前等级覆盖，灰色弱化 */
.plan-included-badge {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  line-height: 1.5;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  color: #8890a0;
}

/* 已开通的卡片：整体降饱和 + 绿色细边，弱化购买引导 */
.vip-plan-owned {
  border-color: rgba(103, 194, 58, 0.3);
  opacity: 0.85;
}

.plan-price { display: flex; align-items: baseline; gap: 4rpx; }
.currency { font-size: 28rpx; color: #d4af37; font-weight: 600; }
.amount { font-size: 56rpx; color: var(--text-strong); font-weight: 800; }

.plan-benefit {
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: 100%;
  padding: 6rpx 0;
}

.plan-benefit-text { font-size: 24rpx; color: var(--text-muted); }
