/* pages/index/index.wxss — 首页样式
 * 颜色统一使用 app.wxss 的主题变量，自动适配深色 / 浅色模式。
 */
.home {
  min-height: 100vh;
  padding: 24rpx;
  /* 底部留出自定义 tabBar 的高度，避免内容被遮住 */
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  /* 星空特效作为全站背景，容器透明 + 抬升层级 */
  position: relative;
  z-index: 2;
  background: transparent;
}

/* ===== Banner =====
 * 结构说明：banner-box 是「图片层 + 文案层」的容器。
 * 文案层不再用负 margin 压到 swiper 上面 —— 在 iOS 上 swiper 是原生组件，
 * 会盖住并吃掉重叠区域的点击，导致「去购物」按钮点不动。
 * 这里改为：图片在上、文案在下，各自独立成块，互不重叠。
 */
.banner-box {
  margin-bottom: 40rpx;
}

.banner {
  width: 100%;
  height: 400rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.banner-img {
  width: 100%;
  height: 100%;
}

/* 无 Banner 图时的渐变底板兜底（不依赖任何外链图片） */
.banner-fallback {
  background: linear-gradient(135deg, #1a1c24 0%, #2a2d38 50%, #1f2330 100%);
}

/* 文案层：紧跟在图片下方，不重叠，保证按钮可点 */
.banner-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 0 40rpx 20rpx;
}

.banner-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.6);
}

.banner-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-bottom: 16rpx;
}

.banner-btn {
  height: 78rpx;
  padding: 0 60rpx;
  border-radius: 40rpx;
  /* 全站统一的品牌蓝渐变。
   * 原值 #d3545c 是红色，属于早期替换脚本的残留，与主题不符。 */
  background: linear-gradient(135deg, #5b9eff, #5b8def);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

/* .goods-name-row / .demo-badge 已统一在 app.wxss 中定义 */

/* ===== 缓存兜底提示 ===== */
.cache-tip {
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
  background: rgba(230, 162, 60, 0.12);
  border: 1rpx solid rgba(230, 162, 60, 0.3);
  border-radius: 14rpx;
  font-size: 24rpx;
  color: var(--warning);
}

/* ===== 快捷入口（2×2 网格，4 个入口一屏放下，不滚动） ===== */
.quick-entry {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.entry-card {
  position: relative;
  flex: 0 0 calc((100% - 20rpx) / 2);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 28rpx 12rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border-base);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.05);
}

.entry-icon { font-size: 48rpx; }

.entry-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.entry-badge {
  position: absolute;
  top: 8rpx;
  right: 20rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  background: var(--danger);
  color: #fff;
  font-size: 19rpx;
  line-height: 30rpx;
  text-align: center;
  border-radius: 15rpx;
  box-sizing: border-box;
}

/* ===== 推荐商品 ===== */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  padding-left: 20rpx;
  border-left: 8rpx solid var(--brand-deep);
}

.section-more {
  font-size: 24rpx;
  color: var(--brand-deep);
  flex-shrink: 0;
}

/* ===== 推荐商品轮播 ===== */
.rec-wrap {
  position: relative;
}

.rec-swiper {
  /* 卡片高度 + 上下留白，避免内容被裁切 */
  height: 720rpx;
}

.rec-item {
  box-sizing: border-box;
  /* 不再留右侧内边距：swiper 已去掉露边距，
     卡片占满整屏宽，与 Banner 观感一致 */
  padding: 0;
}

/* 轮播内卡片：占满 swiper-item 宽度 */
.rec-item .goods-card {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.rec-item .goods-img-wrap {
  flex-shrink: 0;
  height: 380rpx;
}

.rec-item .goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* 演示标记叠加在图片左上角 */
.rec-item .goods-img-wrap .demo-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
}

/* 商品名两行截断（轮播卡空间有限） */
.rec-item .goods-name {
  white-space: normal;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
  height: 2.8em;
}

/* 底部「详情 ›」推到底 */
.rec-item .goods-actions {
  margin-top: auto;
}

/* 自定义指示点 */
.rec-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 20rpx;
}

.rec-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--border-strong);
  transition: width 0.3s, background 0.3s;
}

.rec-dot-active {
  width: 32rpx;
  border-radius: 6rpx;
  background: var(--brand-deep);
}

.merchant-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.merchant-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--bg-hover);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-img { width: 100%; height: 100%; }
.avatar-ph { font-size: 26rpx; }

.merchant-detail {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}

.merchant-name {
  font-size: 24rpx;
  color: var(--text-regular);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.merchant-addr {
  font-size: 20rpx;
  color: var(--text-secondary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* .goods-actions 已统一在 app.wxss 中定义，此处不再覆盖 */

/* ===== 购买弹窗 ===== */
.buy-goods {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--border-base);
}

.buy-goods-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  background: var(--bg-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
  font-size: 48rpx;
}

.buy-goods-image { width: 100%; height: 100%; }

.buy-goods-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.buy-goods-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-strong);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.buy-goods-price {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--danger);
}

.buy-field {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-base);
}

.buy-field-label {
  width: 80rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-muted);
  flex-shrink: 0;
}

.buy-field-extra {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-left: auto;
}

.buy-field-addr {
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
}

.buy-addr {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  background: var(--bg-input);
  border: 1rpx solid var(--border-input);
  border-radius: 12rpx;
}

.buy-addr-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
  min-width: 0;
}

.buy-addr-change {
  font-size: 24rpx;
  color: var(--brand-deep);
  flex-shrink: 0;
}

.buy-summary {
  margin-top: 24rpx;
  padding: 24rpx;
  background: var(--bg-soft);
  border-radius: 16rpx;
}

.buy-summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: var(--text-muted);
  padding: 8rpx 0;
}

.buy-summary-total {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.buy-total {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--danger);
}

/* ===== 地址选择 ===== */
.addr-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 20rpx;
  border-radius: 14rpx;
  border: 1rpx solid transparent;
  margin-bottom: 12rpx;
}

.addr-item-active {
  background: rgba(99, 102, 241, 0.08);
  border-color: rgba(99, 102, 241, 0.25);
}

.addr-radio {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 3rpx solid var(--border-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.addr-item-active .addr-radio { border-color: #5b8def; }

.addr-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #5b9eff, #5b8def);
}

.addr-region {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.addr-detail {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}
