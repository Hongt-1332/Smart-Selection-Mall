/* pages/merchant/ai/ai.wxss
 * 颜色统一使用 app.wxss 的主题变量，自动适配深色 / 浅色模式。
 */
/* picker 展示块：必须显式给底色与边框，
 * 否则在小程序里会露出原生白底（「全白」问题） */
.picker-value {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 76rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  background: var(--bg-input);
  border: 1rpx solid var(--border-input);
  border-radius: 12rpx;
  color: var(--text-primary);
  font-size: 28rpx;
}

/* ===== 操作行 =====
 * 注意：小程序原生 button 默认块级。必须显式
 * display:flex + flex:1 才能让它们在同一行且等分铺满。
 */
.toolbar {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

/* 同行按钮等分铺满整行 */
.toolbar .btn {
  display: flex;
  flex: 1 1 0;
  width: 100%;
  min-width: 0;
  height: 72rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
}

/* 独占一行的按钮铺满整宽 */
.toolbar .btn-block {
  display: flex;
  flex: 1 1 100%;
  width: 100%;
  min-width: 0;
}

/* 统计信息行 */
.meta-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.toolbar-info {
  font-size: 24rpx;
  color: var(--text-secondary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ai-card {
  background: var(--bg-card);
  border: 1rpx solid var(--border-base);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.05);
}

.ai-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-bottom: 18rpx;
  margin-bottom: 14rpx;
  border-bottom: 1rpx solid var(--border-base);
}

.ai-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ai-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 8rpx 0;
}

.ai-label { width: 180rpx; font-size: 24rpx; color: var(--text-muted); flex-shrink: 0; }
.ai-value { flex: 1; font-size: 26rpx; color: var(--text-primary); min-width: 0; word-break: break-all; }

.ai-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--border-base);
}
