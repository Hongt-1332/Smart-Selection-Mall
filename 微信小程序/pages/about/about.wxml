<!--pages/about/about.wxml — 关于-->
<!-- 全站星空背景 -->
<background-effects star-count="36" meteor-count="20" />
<view class="page about">
  <!-- 品牌介绍 -->
  <view class="about-section hero-brand">
    <text class="brand-icon">✦</text>
    <text class="brand-title">智选商城</text>
    <text class="brand-slogan">品质生活 · 一站直达</text>
    <text class="brand-desc">智选商城成立于 2024 年，致力于为消费者提供高品质、高性价比的商品与卓越的购物体验。我们与全球数千家优质品牌深度合作，覆盖数码电子、服饰美妆、家居生活、食品生鲜等全品类商品。</text>
  </view>

  <!-- 平台数据 -->
  <view class="about-section">
    <text class="section-title">平台数据</text>
    <view class="stats-grid">
      <view class="stat-card" wx:for="{{stats}}" wx:key="label">
        <text class="stat-num">{{item.num}}</text>
        <text class="stat-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 技术架构 -->
  <view class="about-section">
    <text class="section-title">技术架构</text>
    <view class="tech-grid">
      <view class="tech-item" wx:for="{{techs}}" wx:key="name">
        <text class="tech-icon">{{item.icon}}</text>
        <text class="tech-name">{{item.name}}</text>
        <text class="tech-ver">{{item.ver}}</text>
      </view>
    </view>
  </view>

  <!-- 核心功能 -->
  <view class="about-section">
    <text class="section-title">核心功能</text>
    <view class="feature-list">
      <view class="feature-item" wx:for="{{features}}" wx:key="title">
        <text class="feature-icon">{{item.icon}}</text>
        <view class="feature-content">
          <text class="feature-title">{{item.title}}</text>
          <text class="feature-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 联系我们 -->
  <view class="about-section">
    <text class="section-title">联系我们</text>
    <view class="contact-list">
      <view class="contact-item" wx:for="{{contacts}}" wx:key="label">
        <text class="contact-label">{{item.label}}</text>
        <text class="contact-value">{{item.value}}</text>
      </view>
    </view>
  </view>

  <!-- 版权 -->
  <view class="about-footer">
    <text class="footer-main">© 2024 - 2026 智选商城 | Version 1.0.0</text>
    <text class="footer-sub">All Rights Reserved</text>
  </view>
</view>

<!-- 全局确认弹窗（深色主题，替代原生 wx.showModal） -->
<confirm-dialog id="confirmDialog" />
