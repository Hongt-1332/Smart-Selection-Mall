/* components/background-effects/index.wxss — 星空特效样式 */

/**
 * 宿主节点（自定义组件本身）。
 * 必须显式设为 fixed 铺满，否则宿主的层叠上下文会限制内部元素的定位表现。
 */
:host {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 1;
  pointer-events: none;
  overflow: hidden;
}

/**
 * 夜空底色。
 * 星星和流星都是白 / 浅色，必须叠在深色底上才可见。
 * 因此这里自带一层固定深色渐变，不跟随系统浅色模式 ——
 * 否则浅色模式下会变成「白底白星」，什么都看不见。
 */
.bg-effects {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  overflow: hidden;
  background-color: #070a16;
  background-image: radial-gradient(
      ellipse at 20% 0%,
      #1b2545 0%,
      rgba(27, 37, 69, 0) 55%
    ),
    radial-gradient(
      ellipse at 85% 15%,
      #2a1e42 0%,
      rgba(42, 30, 66, 0) 50%
    ),
    radial-gradient(
      ellipse at 50% 100%,
      #101a33 0%,
      rgba(16, 26, 51, 0) 60%
    ),
    linear-gradient(180deg, #070a16 0%, #0a0f1f 45%, #05070f 100%);
}

/* ===== 星星 ===== */
.stars-container {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
}

.star {
  position: absolute;
  background: #fff;
  border-radius: 50%;
  animation: twinkle ease-in-out infinite alternate;
  box-shadow: 0 0 5px 2px rgba(255, 255, 255, 0.7);
  opacity: 0.75;
}

@keyframes twinkle {
  0%   { opacity: 0.35; transform: scale(0.8); }
  50%  { opacity: 1;    transform: scale(1.3); }
  100% { opacity: 0.5;  transform: scale(0.9); }
}

/* ===== 星座 ===== */
.constellations {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
}

.constellation {
  position: absolute;
  width: 90px;
  height: 90px;
  opacity: 0.65;
}

/* 连线：用细长 view + rotate 模拟 SVG 线段 */
.cz-line {
  position: absolute;
  height: 1px;
  background: rgba(255, 255, 255, 0.45);
  transform-origin: 0 50%;
  /* 虚线效果 */
  background-image: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0.45) 0,
    rgba(255, 255, 255, 0.45) 55%,
    transparent 55%,
    transparent 100%
  );
  background-size: 5px 1px;
  background-repeat: repeat-x;
}

/* 星点 */
.cz-point {
  position: absolute;
  width: 3px;
  height: 3px;
  margin-left: -1.5px;
  margin-top: -1.5px;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 0 6px rgba(255, 255, 255, 0.9);
  animation-name: pulse-star;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
  animation-direction: alternate;
}

@keyframes pulse-star {
  0%   { opacity: 0.6; }
  100% { opacity: 1; }
}

.cz-name {
  position: absolute;
  bottom: -12px;
  left: 50%;
  transform: translateX(-50%);
  font-size: 8px;
  color: rgba(255, 255, 255, 0.55);
  white-space: nowrap;
}

/* ===== 流星 ===== */
.meteor {
  position: absolute;
  border-radius: 50%;
  opacity: 0;
  animation: meteor-fly linear infinite;
  pointer-events: none;
  will-change: transform, opacity;
  background: radial-gradient(
    circle at 50% 50%,
    transparent 20%,
    var(--color, rgba(255, 255, 255, 0.85)) 50%,
    transparent 100%
  );
  box-shadow: 0 0 calc(var(--glow, 20px) * 0.8) calc(var(--glow, 20px) * 0.4) var(--color, rgba(255, 255, 255, 0.6));
  filter: blur(1px);
}

@keyframes meteor-fly {
  0%   { opacity: 0;    transform: translate(0, 0) rotate(var(--angle, -40deg)) scale(0.15); }
  2%   { opacity: 0.85; }
  10%  { opacity: 0.95; transform: translate(80px, 112px) rotate(var(--angle, -40deg)) scale(1); }
  25%  { opacity: 0.8;  transform: translate(180px, 252px) rotate(var(--angle, -40deg)) scale(0.85); }
  45%  { opacity: 0.55; transform: translate(300px, 420px) rotate(var(--angle, -40deg)) scale(0.6); }
  65%  { opacity: 0.25; transform: translate(420px, 588px) rotate(var(--angle, -40deg)) scale(0.35); }
  85%  { opacity: 0.08; transform: translate(540px, 756px) rotate(var(--angle, -40deg)) scale(0.15); }
  100% { opacity: 0;    transform: translate(640px, 896px) rotate(var(--angle, -40deg)) scale(0); }
}
