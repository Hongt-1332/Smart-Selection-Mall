<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.fafu.database.mapper.businessmapper.managermapper.ManagerTradeMapper">

    <update id="updateList">
        <foreach collection="list" item="item" separator=";">
            UPDATE trade
            <set>
                <if test="item.quantity != null">quantity = #{item.quantity},</if>
                <if test="item.originAddress != null">originAddress = #{item.originAddress},</if>
                <if test="item.currentAddress != null">currentAddress = #{item.currentAddress},</if>
                <if test="item.targetAddress != null">targetAddress = #{item.targetAddress},</if>
                <if test="item.createTime != null">createTime = #{item.createTime},</if>
                <if test="item.payTime != null">payTime = #{item.payTime},</if>
                <if test="item.cancelTime != null">cancelTime = #{item.cancelTime},</if>
                <if test="item.finishTime != null">finishTime = #{item.finishTime},</if>
                <if test="item.delete != null">`delete` = #{item.delete},</if>
            </set>
            WHERE id = #{item.id}
        </foreach>
    </update>

</mapper>