/* pages/ai-recommend/ai-recommend.wxss — 智能推荐（tabBar 页）*/

.chat-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  /* 星空特效作为全站背景，容器透明 + 抬升层级 */
  position: relative;
  z-index: 2;
  background: transparent;
  padding: 24rpx;
  /* 底部留出自定义 tabBar 的高度，避免内容被遮住 */
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* ===== 头部 ===== */
.chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border-base);
  border-radius: 18rpx;
  margin-bottom: 20rpx;
  flex-shrink: 0;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 28rpx;
  color: var(--text-primary);
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--success);
  box-shadow: 0 0 12rpx rgba(103, 194, 58, 0.5);
}

.header-right { display: flex; align-items: center; gap: 16rpx; }

/* ===== 消息区（固定高度，内部滚动） ===== */
.messages-container {
  flex-shrink: 0;
  height: 560rpx;
  padding: 8rpx 0;
  background: var(--bg-card);
  border: 1rpx solid var(--border-base);
  border-radius: 18rpx;
}

/* scroll-view 内部需要内边距，用子元素撑开 */
.messages-container > view:first-child { margin-top: 20rpx; }

.message-row {
  display: flex;
  gap: 16rpx;
  margin: 0 20rpx 26rpx;
}

.message-row.user { flex-direction: row-reverse; }

.avatar-wrap { flex-shrink: 0; }

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--bg-hover);
  border: 1rpx solid var(--border-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.avatar.ai { background: linear-gradient(135deg, #5b9eff, #5b8def); }

.bubble-wrap {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  max-width: 76%;
}

.message-row.user .bubble-wrap { align-items: flex-end; }

.bubble {
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  background: var(--bg-soft);
  border: 1rpx solid var(--border-base);
}

.bubble.user {
  background: linear-gradient(135deg, #5b9eff, #5b8def);
  border: none;
}

.bubble-text {
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}

.bubble.user .bubble-text { color: #fff; }

.msg-time { font-size: 20rpx; color: var(--text-muted); opacity: 0.7; }
.msg-bottom { height: 24rpx; }

/* ===== 快捷标签（swiper 承载，一屏 2 个） ===== */
.quick-actions {
  height: 88rpx;
  margin-top: 20rpx;
  flex-shrink: 0;
}

.quick-item {
  box-sizing: border-box;
  padding-right: 14rpx;
  display: flex;
  align-items: center;
}

.quick-btn {
  width: 100%;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  background: var(--bg-soft);
  border: 1rpx solid var(--border-strong);
  font-size: 24rpx;
  color: var(--text-regular);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ===== 输入区 ===== */
.input-wrapper {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
  margin-bottom: 24rpx;
  flex-shrink: 0;
}

/* 输入框固定单行高度，示例文案不会换行 */
.chat-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  padding: 0 24rpx;
  background: var(--bg-input);
  border: 1rpx solid var(--border-input);
  border-radius: 16rpx;
  color: var(--text-primary);
  font-size: 27rpx;
}

.send-btn {
  flex-shrink: 0;
  width: 130rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #5b9eff, #5b8def);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 80rpx;
  padding: 0;
}
.send-btn::after { border: none; }
.send-btn[disabled] { opacity: 0.45; }

/* ===== 推荐面板 ===== */
.recommend-panel {
  background: var(--bg-card);
  border: 1rpx solid var(--border-base);
  border-radius: 20rpx;
  padding: 24rpx;
  flex-shrink: 0;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.panel-title { font-size: 32rpx; font-weight: 600; color: var(--text-primary); }
.panel-sub { font-size: 22rpx; color: var(--text-muted); }

.panel-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 40rpx 0;
}

.placeholder-icon { font-size: 76rpx; }
.placeholder-title { font-size: 30rpx; color: var(--text-primary); font-weight: 600; }
.placeholder-desc { font-size: 24rpx; color: var(--text-muted); text-align: center; line-height: 1.6; }

/* ===== 推荐商品轮播 ===== */
.rec-swiper {
  height: 640rpx;
}

.rec-item {
  box-sizing: border-box;
  padding-right: 20rpx;
}

/* 轮播内卡片占满一屏 */
.rec-item .goods-card {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.rec-item .goods-img-wrap {
  flex-shrink: 0;
  height: 320rpx;
}

.rec-item .goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.rec-item .goods-name {
  white-space: normal;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
  height: 2.8em;
}

.rec-item .goods-actions { margin-top: auto; }

/* 指示点 */
.rec-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 20rpx;
}

.rec-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--border-strong);
  transition: width 0.3s, background 0.3s;
}

.rec-dot-active {
  width: 32rpx;
  border-radius: 6rpx;
  background: var(--brand-deep);
}

/* 复用全局 .goods-card 尺寸，这里只补推荐场景特有的定位 */
.card-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #f56c6c, #e6a23c);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  z-index: 2;
}

.goods-img-wrap { position: relative; }

.merchant-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.merchant-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--bg-hover);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-img { width: 100%; height: 100%; }
.avatar-ph { font-size: 22rpx; }

.merchant-name {
  font-size: 22rpx;
  color: var(--text-secondary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
