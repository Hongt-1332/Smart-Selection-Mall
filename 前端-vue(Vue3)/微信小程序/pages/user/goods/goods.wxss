/* pages/user/goods/goods.wxss
 * 颜色统一使用 app.wxss 的主题变量，自动适配深色 / 浅色模式。
 */

/* ===== 区块标题 ===== */
.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  padding-left: 20rpx;
  border-left: 8rpx solid var(--brand-deep);
}

/* ===== 个人中心入口 ===== */
.user-nav {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.unav-item {
  flex: 0 0 calc((100% - 32rpx) / 3);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 8rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border-base);
  border-radius: 16rpx;
}

/* 图标容器：为角标提供定位参照 */
.unav-icon-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.unav-icon { font-size: 40rpx; }

/* 购物车角标：绝对定位在图标右上角 */
.unav-badge {
  position: absolute;
  top: -8rpx;
  left: 26rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 7rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background-color: #f56c6c;
  color: #ffffff;
  font-size: 18rpx;
  line-height: 28rpx;
  text-align: center;
}

.unav-text {
  font-size: 24rpx;
  color: var(--text-regular);
}

/* ===== 缓存兜底提示 ===== */
.cache-tip {
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
  background: rgba(230, 162, 60, 0.12);
  border: 1rpx solid rgba(230, 162, 60, 0.3);
  border-radius: 14rpx;
  font-size: 24rpx;
  color: var(--warning);
}

/* ===== 搜索栏（小程序标准做法：input + confirm-type="search"） ===== */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.search-bar .search-input {
  flex: 1;
  min-width: 0;
}

.search-bar .btn {
  flex-shrink: 0;
}

/* 区块右侧「搜索 ›」入口 */
.section-more {
  font-size: 24rpx;
  color: var(--brand-deep);
  flex-shrink: 0;
}

/* ===== 生效中的搜索条件标签 ===== */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 22rpx;
  background: rgba(91, 158, 255, 0.15);
  border: 1rpx solid rgba(91, 158, 255, 0.3);
  border-radius: 30rpx;
  font-size: 24rpx;
  color: var(--brand);
}

.chip-x { font-size: 20rpx; opacity: 0.8; }

.chip-clear {
  background: var(--bg-hover);
  border-color: var(--border-strong);
  color: var(--text-secondary);
}

.price-range {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
}

.range-sep { color: var(--text-muted); font-size: 26rpx; }

.merchant-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.merchant-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--bg-hover);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-img { width: 100%; height: 100%; }
.avatar-ph { font-size: 26rpx; }

.merchant-detail { display: flex; flex-direction: column; min-width: 0; flex: 1; }

.merchant-name {
  font-size: 24rpx;
  color: var(--text-regular);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.merchant-addr {
  font-size: 20rpx;
  color: var(--text-secondary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* .goods-actions 已统一在 app.wxss 中定义，此处不再覆盖 */

/* ===== 购买弹窗 ===== */
.buy-goods {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--border-base);
}

.buy-goods-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  background: var(--bg-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
  font-size: 48rpx;
}

.buy-goods-image { width: 100%; height: 100%; }

.buy-goods-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 10rpx; }

.buy-goods-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-strong);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.buy-goods-price { font-size: 36rpx; font-weight: 800; color: var(--danger); }

.buy-field {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-base);
}

.buy-field-label {
  width: 80rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-muted);
  flex-shrink: 0;
}

.buy-field-extra { font-size: 24rpx; color: var(--text-secondary); margin-left: auto; }

.buy-field-addr { flex-direction: column; align-items: flex-start; gap: 16rpx; }

.buy-addr {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  background: var(--bg-input);
  border: 1rpx solid var(--border-input);
  border-radius: 12rpx;
}

.buy-addr-text { flex: 1; font-size: 26rpx; color: var(--text-primary); min-width: 0; }
.buy-addr-change { font-size: 24rpx; color: var(--brand-deep); flex-shrink: 0; }

/* ===== 地址列表 ===== */
.addr-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 20rpx;
  border-radius: 14rpx;
  border: 1rpx solid transparent;
  margin-bottom: 12rpx;
}

.addr-item-active {
  background: rgba(99, 102, 241, 0.08);
  border-color: rgba(99, 102, 241, 0.25);
}

.addr-radio {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 3rpx solid var(--border-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.addr-item-active .addr-radio { border-color: #5b8def; }

.addr-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #5b9eff, #5b8def);
}

.addr-region { display: block; font-size: 28rpx; color: var(--text-primary); font-weight: 500; }
.addr-detail { display: block; font-size: 24rpx; color: var(--text-secondary); margin-top: 4rpx; }
