<!--pages/user/bg/bg.wxml — 我的主页-->
<!-- 全站星空背景 -->
<background-effects star-count="36" meteor-count="20" />
<view class="page">
  <!-- 调试模式提示条 -->
  <view class="demo-bar" wx:if="{{isDemo}}">
    <text class="demo-text">🔧 调试模式 · 当前为演示数据，未登录也可预览</text>
  </view>

  <view class="loading" wx:if="{{loading}}">加载中...</view>

  <!-- 封面 -->
  <view class="cover-section">
    <view class="cover-bg">
      <image wx:if="{{bgImages.length}}" class="cover-image" src="{{bgImages[0].url}}" mode="aspectFill" />
    </view>
    <view class="cover-overlay"></view>
    <view class="cover-content">
      <view class="avatar-box">
        <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
        <text wx:else class="avatar-ph">👤</text>
      </view>
      <view class="cover-center">
        <text class="cover-name">{{userInfo.userName || '未设置'}}</text>
        <text class="cover-addr">@{{userInfo.account}}</text>
        <view class="cover-tags">
          <text class="tag-vip" wx:if="{{userInfo.level > 0}}">👑 VIP{{userInfo.level}} · {{userInfo.levelName}}</text>
          <text class="tag-bg">🖼️ {{bgImages.length}} 张背景</text>
        </view>
      </view>
      <view class="vip-card" wx:if="{{userInfo.level > 0}}">
        <text class="vip-badge">VIP{{userInfo.level}}</text>
        <text class="vip-name">{{userInfo.levelName}}</text>
        <text class="vip-sub">剩余{{userInfo.vipRemainingTime}}天</text>
      </view>
    </view>
  </view>

  <!-- 个人简介 -->
  <view class="section" wx:if="{{userInfo.describe}}">
    <text class="section-title">📝 个人简介</text>
    <view class="intro-box">
      <text class="intro-text">{{userInfo.describe}}</text>
    </view>
  </view>

  <!-- 背景图片：swiper 横向滑动浏览（替代原来的左右翻页按钮） -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">🖼️ 背景图片</text>
      <text class="nav-info">{{bgImages.length}} 张</text>
    </view>

    <swiper
      class="bg-swiper"
      wx:if="{{bgImages.length}}"
      previous-margin="0"
      next-margin="70rpx"
      circular="{{bgImages.length > 1}}"
      duration="400"
      bindchange="onBgSwiperChange"
    >
      <swiper-item class="bg-swiper-item" wx:for="{{bgImages}}" wx:key="id">
        <view class="bg-card" data-url="{{item.url}}" bindtap="previewBg">
          <image class="bg-card-img" src="{{item.url}}" mode="aspectFill" />
          <text class="bg-card-seq">{{item.sequence}}</text>
        </view>
      </swiper-item>
    </swiper>

    <!-- 指示点 -->
    <view class="bg-dots" wx:if="{{bgImages.length > 1}}">
      <view class="bg-dot {{bgIdx === index ? 'bg-dot-active' : ''}}"
        wx:for="{{bgImages}}" wx:key="id"></view>
    </view>

    <view class="bg-placeholder" wx:if="{{!bgImages.length}}">
      <text class="bg-ph-icon">🖼️</text>
      <text class="bg-ph-text">暂无图片</text>
    </view>
  </view>

  <!-- 在售商品 -->
  <view class="section" wx:if="{{goodsList.length > 0}}">
    <view class="section-header">
      <text class="section-title">🛍️ 在售商品</text>
      <text class="goods-total">共 {{goodsList.length}} 件</text>
    </view>

    <!-- 纯浏览态：点整卡看详情，卡上不做数量增减 -->
    <view class="goods-grid">
      <view class="goods-card" wx:for="{{goodsList}}" wx:key="id"
        data-id="{{item.id}}" bindtap="goDetail">
        <view class="goods-img-wrap">
          <image wx:if="{{item.imagePath}}" class="goods-img" src="{{item.imageUrl}}" mode="aspectFill" />
          <text wx:else class="goods-img-placeholder">暂无图片</text>
        </view>
        <view class="goods-info">
          <view class="goods-name-row">
            <text class="goods-name">{{item.goodsName}}</text>
            <text class="demo-badge" wx:if="{{isDemo}}">演示</text>
          </view>
          <text class="goods-desc" wx:if="{{item.describe}}">{{item.describe}}</text>
          <view class="goods-price-row">
            <text class="goods-price">¥{{item.goodsPrice}}</text>
            <text class="goods-stock">库存 {{item.goodsStock}}</text>
          </view>

          <view class="goods-actions">
            <text class="goods-added" wx:if="{{item.cartQuantity > 0}}">🛒 已购 {{item.cartQuantity}} 件</text>
            <text class="goods-added-ph" wx:else>未购买</text>
            <text class="goods-detail-hint">查看详情 ›</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 全局确认弹窗（深色主题，替代原生 wx.showModal） -->
<confirm-dialog id="confirmDialog" />
